<view class="app">
  <!-- 上半屏：3D 微缩城市（可手指拖拽转动镜头） -->
  <canvas
    type="webgl"
    id="gl"
    class="gl"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchEnd"
  ></canvas>

  <!-- 3D 初始化失败时的降级提示：天气信息仍可正常使用 -->
  <view class="glfail" wx:if="{{glFailed}}">
    <text class="glfail-e">🏙️</text>
    <text class="glfail-t">当前设备无法显示 3D 城市</text>
    <text class="glfail-s">天气信息仍可正常查看</text>
  </view>

  <!-- 昼夜切换（浮在画布右上角） -->
  <view class="daynight" wx:if="{{!glFailed}}" bindtap="onToggleNight">{{night ? '🌙' : '☀️'}}</view>

  <!-- 下半屏：控制面板（普通 view，不与 canvas 重叠，一定可见） -->
  <view class="panel">
    <view class="grip"></view>
    <view class="summary">
      <view class="s-left">
        <text class="s-city">{{place}}</text>
        <text class="s-kind">{{emoji}} {{kindLabel}} · {{dateLabel}}</text>
      </view>
      <text class="s-temp">{{temp}}°</text>
    </view>

    <!-- 七天预报（云函数早就返回了 daily，之前一直没用上） -->
    <scroll-view class="fc" scroll-x enable-flex wx:if="{{forecast.length}}">
      <view class="fc-item" wx:for="{{forecast}}" wx:key="label">
        <text class="fc-d">{{item.label}}</text>
        <text class="fc-e">{{item.emoji}}</text>
        <text class="fc-hi">{{item.hi}}°</text>
        <text class="fc-lo">{{item.lo}}°</text>
      </view>
    </scroll-view>

    <view class="row">
      <input
        class="ipt"
        placeholder="搜索城市，如 上海 / 北京"
        placeholder-class="ph"
        confirm-type="search"
        value="{{q}}"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <view class="btn" bindtap="onSearch">搜索</view>
      <view class="btn ghost" bindtap="onLocate">📍</view>
    </view>

    <scroll-view class="chips" scroll-x enable-flex>
      <view
        wx:for="{{kinds}}"
        wx:key="*this"
        class="chip {{item === curKind ? 'on' : ''}}"
        data-k="{{item}}"
        bindtap="onChip"
      >{{labels[item]}}</view>
    </scroll-view>

    <view class="hint" wx:if="{{loading}}">加载中…</view>
    <view class="errbar" wx:elif="{{errMsg}}">
      <text class="err-t">{{errMsg}}</text>
      <view class="err-btn" bindtap="onRetry">重试</view>
    </view>

    <!-- Open-Meteo 为 CC-BY 4.0，署名必须在界面上可见 -->
    <view class="credit">
      <text class="credit-t">天气数据 Open-Meteo (CC-BY 4.0) · 定位仅用于查询本地天气</text>
      <text class="credit-a" bindtap="onAbout">关于</text>
    </view>
  </view>
</view>
