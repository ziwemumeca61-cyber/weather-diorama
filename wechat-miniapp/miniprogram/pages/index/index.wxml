<view class="app">
  <!-- 上半屏：3D 微缩城市（可手指拖拽转动镜头） -->
  <canvas
    type="webgl"
    id="gl"
    class="gl"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchEnd"
  ></canvas>

  <!-- 用于把本地照片 / AI 背景与天气心情本地合成；不显示，不上传。 -->
  <canvas type="2d" id="weather-mood-canvas" class="mood-canvas"></canvas>

  <!-- 3D 初始化失败时的降级提示：天气信息仍可正常使用 -->
  <view class="glfail" wx:if="{{glFailed}}">
    <text class="glfail-e">🏙️</text>
    <text class="glfail-t">当前设备无法显示 3D 城市</text>
    <text class="glfail-s">天气信息仍可正常查看</text>
  </view>

  <!-- 昼夜切换（浮在画布右上角） -->
  <view class="daynight" wx:if="{{!glFailed}}" bindtap="onToggleNight">{{night ? '🌙' : '☀️'}}</view>

  <!-- 下半屏：控制面板（普通 view，不与 canvas 重叠，一定可见） -->
  <view class="panel">
    <view class="grip"></view>
    <view class="summary">
      <view class="s-left">
        <text class="s-city">{{place}}</text>
        <text class="s-kind">{{emoji}} {{kindLabel}} · {{dateLabel}}</text>
      </view>
      <text class="s-temp">{{temp}}°</text>
    </view>

    <!-- 七天预报（云函数早就返回了 daily，之前一直没用上） -->
    <scroll-view class="fc" scroll-x enable-flex wx:if="{{forecast.length}}">
      <view class="fc-item" wx:for="{{forecast}}" wx:key="label">
        <text class="fc-d">{{item.label}}</text>
        <text class="fc-e">{{item.emoji}}</text>
        <text class="fc-hi">{{item.hi}}°</text>
        <text class="fc-lo">{{item.lo}}°</text>
      </view>
    </scroll-view>

    <view class="mood-entry" bindtap="onMoodToggle">
      <view class="mood-entry-copy">
        <text class="mood-entry-icon">💭</text>
        <view class="mood-entry-text">
          <text class="mood-entry-title">天气心情贴</text>
          <text class="mood-entry-sub">选一种心情，让天气替你表达</text>
        </view>
      </view>
      <text class="mood-entry-btn">去制作</text>
    </view>

    <view class="row">
      <input
        class="ipt"
        placeholder="搜索城市，如上海/北京"
        placeholder-class="ph"
        confirm-type="search"
        value="{{q}}"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <view class="btn" bindtap="onSearch">搜索</view>
      <view class="btn ghost" bindtap="onLocate">📍</view>
    </view>

    <view class="hint" wx:if="{{loading}}">加载中…</view>
    <view class="errbar" wx:elif="{{errMsg}}">
      <text class="err-t">{{errMsg}}</text>
      <view class="err-btn" bindtap="onRetry">重试</view>
    </view>

    <!-- Open-Meteo 为 CC-BY 4.0，署名必须在界面上可见 -->
    <view class="credit">
      <text class="credit-t">天气数据 Open-Meteo (CC-BY 4.0) · 定位仅用于查询本地天气</text>
      <text class="credit-a" bindtap="onAbout">关于</text>
    </view>
  </view>

  <!-- 独立制作层：避免把主页挤得很长，图片始终由用户主动选择或主动生成。 -->
  <view class="mood-mask" wx:if="{{moodOpen}}" bindtap="onMoodClose">
    <view class="mood-sheet" catchtap="onMoodSheetTap">
      <view class="mood-sheet-head">
        <view>
          <text class="mood-sheet-title">今天想怎么表达？</text>
          <text class="mood-sheet-sub">天气不是背景，是此刻心情的化身</text>
        </view>
        <view class="mood-close" catchtap="onMoodClose" aria-label="关闭天气心情贴">×</view>
      </view>

      <scroll-view
        class="mood-sheet-body"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        scroll-into-view="{{moodScrollTarget}}"
      >
      <view class="mood-native-jump" bindtap="onShowNativePublish">
        <text>想直接创作？查看微信原生「发一条」</text>
        <text class="mood-native-jump-arrow">↓</text>
      </view>

      <view class="mood-tabs">
        <view class="mood-tab {{moodTab === 'photo' ? 'mood-tab-on' : ''}}" data-tab="photo" bindtap="onMoodTab">我的照片</view>
        <view class="mood-tab {{moodTab === 'ai' ? 'mood-tab-on' : ''}}" data-tab="ai" bindtap="onMoodTab">AI 心情贴</view>
      </view>

      <scroll-view class="mood-options" scroll-x enable-flex>
        <view
          wx:for="{{moodOptions}}"
          wx:key="key"
          class="mood-option {{moodKey === item.key ? 'mood-option-on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onMoodPick"
        >{{item.emoji}} {{item.label}}</view>
      </scroll-view>

      <view wx:if="{{moodTab === 'ai'}}">
        <text class="mood-section-label">选择画面风格</text>
        <scroll-view class="mood-styles" scroll-x enable-flex>
          <view
            wx:for="{{moodStyles}}"
            wx:key="key"
            class="mood-style {{moodStyleKey === item.key ? 'mood-style-on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onMoodStylePick"
          >
            <text class="mood-style-name">{{item.emoji}} {{item.label}}</text>
            <text class="mood-style-sub">{{item.copy}}</text>
          </view>
        </scroll-view>
      </view>

      <textarea
        class="mood-textarea"
        value="{{moodText}}"
        maxlength="80"
        placeholder="写一句没说出口的话，天气会替你表达（可不写）"
        placeholder-class="mood-placeholder"
        auto-height
        bindinput="onMoodText"
      />

      <view class="mood-preview-wrap">
        <image class="mood-preview" wx:if="{{moodPreview}}" src="{{moodPreview}}" mode="aspectFill" />
        <view class="mood-preview-empty" wx:else>
          <text class="mood-preview-emoji">{{moodTab === 'photo' ? '📷' : '✨'}}</text>
          <text>{{moodLoading ? '天气正在替你组织情绪…' : moodTab === 'photo' ? '选择一张照片，把此刻天气贴上去' : '选一种心情，让天气替你表达'}}</text>
        </view>
      </view>

      <view class="mood-main-action" wx:if="{{moodTab === 'photo'}}" bindtap="onChooseMoodPhoto">
        {{moodLoading ? '正在合成…' : moodPhoto ? '换一张照片' : '从相册选择 / 现在拍照'}}
      </view>
      <view class="mood-main-action {{!moodImageEnabled ? 'mood-main-disabled' : ''}}" wx:elif="{{!moodPreview}}" bindtap="onGenerateAiMood">
        {{moodLoading ? '正在把心情变成天气…' : moodImageEnabled ? '生成 AI 心情画面' : '心情画面暂不可用'}}
      </view>

      <text class="mood-ai-note" wx:if="{{moodTab === 'ai' && moodPreview}}">已生成背景。修改上面的文字只会本地重新排版，不会再消耗生图额度。</text>

      <view class="mood-ready" wx:if="{{moodPreview}}">
        <view class="mood-publish-action" bindtap="onPublishMoodSticker">
          <text class="mood-publish-action-icon">◉</text>
          <text>发布天气心情贴</text>
        </view>
        <view class="mood-ready-row">
          <view class="mood-secondary" bindtap="onSaveMoodSticker">保存图片</view>
          <view class="mood-secondary" bindtap="onCopyMoodArticle">复制图文</view>
        </view>
        <text class="mood-ready-note">发布时会自动带入图片和文案；保存、复制可作为备用。</text>
      </view>

      <view class="mood-publish-entry" id="mood-native-publish">
        <view class="mood-publish-copy">
          <text class="mood-publish-title">大家的天气心情贴</text>
          <text class="mood-publish-sub">浏览同话题内容，也可以从微信原生「发一条」开始创作。</text>
        </view>
        <official-account-publish
          topic="天气心情贴"
          limit="4"
          placeholder="来发第一条天气心情吧"
          background-color="#f4f1ec"
          color-unity="{{true}}"
          show-related="{{false}}"
          recommend-path="/pages/index/index"
          recommend-title="制作我的天气心情贴"
          binderror="onMoodComponentError"
          bindempty="onMoodComponentEmpty"
          bindpublishsuccess="onMoodComponentPublishSuccess"
          bindpublishfail="onMoodComponentPublishFail"
        ></official-account-publish>
        <text class="mood-publish-tip">原生发表按钮请在 Android 或 iPhone 真机中测试。</text>
      </view>

      <text class="mood-privacy">本地照片只在手机上合成，不会上传；AI 背景仅在你主动点击生成时调用，心情文字不会发给生图模型。</text>
      </scroll-view>
    </view>
  </view>
</view>
