<view class="app">
  <!-- 上半屏：3D 微缩城市（可手指拖拽转动镜头） -->
  <canvas
    type="webgl"
    id="gl"
    class="gl"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchEnd"
  ></canvas>

  <!-- 生成天气贴图时使用的隐藏 2D 合成画布；不参与页面布局。 -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

  <!-- 3D 初始化失败时的降级提示：天气信息仍可正常使用 -->
  <view class="glfail" wx:if="{{glFailed}}">
    <text class="glfail-e">🏙️</text>
    <text class="glfail-t">当前设备无法显示 3D 城市</text>
    <text class="glfail-s">天气信息仍可正常查看</text>
  </view>

  <!-- 昼夜切换（浮在画布右上角） -->
  <view class="daynight" wx:if="{{!glFailed}}" bindtap="onToggleNight">{{night ? '🌙' : '☀️'}}</view>

  <!-- 下半屏：控制面板（普通 view，不与 canvas 重叠，一定可见） -->
  <view class="panel">
    <view class="grip"></view>
    <view class="summary">
      <view class="s-left">
        <text class="s-city">{{place}}</text>
        <text class="s-kind">{{emoji}} {{kindLabel}} · {{dateLabel}}</text>
      </view>
      <text class="s-temp">{{temp}}°</text>
    </view>

    <!-- 七天预报（云函数早就返回了 daily，之前一直没用上） -->
    <scroll-view class="fc" scroll-x enable-flex wx:if="{{forecast.length}}">
      <view class="fc-item" wx:for="{{forecast}}" wx:key="label">
        <text class="fc-d">{{item.label}}</text>
        <text class="fc-e">{{item.emoji}}</text>
        <text class="fc-hi">{{item.hi}}°</text>
        <text class="fc-lo">{{item.lo}}°</text>
      </view>
    </scroll-view>

    <view class="share-entry" hover-class="share-entry-hover" bindtap="onShareImage">
      <view class="share-entry-icon">🖼️</view>
      <view class="share-entry-copy">
        <text class="share-entry-title">生成天气贴图</text>
        <text class="share-entry-sub">把这座 3D 城市分享给朋友</text>
      </view>
      <view class="share-entry-btn">{{shareImageLoading ? '生成中' : '分享'}}</view>
    </view>

    <!-- AI 先做成审核安全的可开关模块：默认关闭，开启后只有用户主动点击才调用额度。 -->
    <view class="ai-entry" wx:if="{{aiEnabled}}">
      <view class="ai-entry-copy">
        <text class="ai-entry-icon">☁️</text>
        <view class="ai-entry-text">
          <text class="ai-entry-title">AI天气助手</text>
          <text class="ai-entry-sub">看天气、问出行、生成分享文案，一个入口解决</text>
        </view>
      </view>
      <view class="ai-entry-btn" bindtap="onAiToggle">{{aiOpen ? '收起' : '打开'}}</view>
    </view>

    <view class="ai-panel" wx:if="{{aiEnabled && aiOpen}}">
      <view class="ai-panel-head">
        <text class="ai-panel-title">今天想问什么？</text>
        <text class="ai-panel-note">只在你点击提问时调用</text>
      </view>
      <view class="ai-prompts">
        <view class="ai-prompt" wx:for="{{aiPrompts}}" wx:key="*this" data-q="{{item}}" bindtap="onAiPrompt">{{item}}</view>
      </view>
      <view class="ai-ask-row">
        <input
          class="ai-input"
          placeholder="例如：周末适合去海边吗？"
          placeholder-class="ph"
          maxlength="200"
          value="{{aiQuestion}}"
          bindinput="onAiInput"
          bindconfirm="onAiAsk"
        />
        <view class="ai-ask-btn" bindtap="onAiAsk">{{aiLoading ? '分析中' : '提问'}}</view>
      </view>
      <view class="ai-result" wx:if="{{aiLoading || aiText}}">
        <text class="ai-result-text">{{aiLoading ? '正在结合当前天气分析…' : aiText}}</text>
        <text class="ai-cache" wx:if="{{aiCacheHint}}">{{aiCacheHint}}</text>
        <view class="ai-copy" wx:if="{{aiText}}" bindtap="onAiCopy">复制结果</view>
      </view>
      <text class="ai-disclaimer">AI 建议仅作日常参考，雷雨、大风等情况以官方预警为准。</text>
    </view>

    <view class="row">
      <input
        class="ipt"
        placeholder="搜索城市，如上海/北京"
        placeholder-class="ph"
        confirm-type="search"
        value="{{q}}"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <view class="btn" bindtap="onSearch">搜索</view>
      <view class="btn ghost" bindtap="onLocate">📍</view>
    </view>

    <view class="hint" wx:if="{{loading}}">加载中…</view>
    <view class="errbar" wx:elif="{{errMsg}}">
      <text class="err-t">{{errMsg}}</text>
      <view class="err-btn" bindtap="onRetry">重试</view>
    </view>

    <!-- Open-Meteo 为 CC-BY 4.0，署名必须在界面上可见 -->
    <view class="credit">
      <text class="credit-t">天气数据 Open-Meteo (CC-BY 4.0) · 定位仅用于查询本地天气</text>
      <text class="credit-a" bindtap="onAbout">关于</text>
    </view>
  </view>
</view>
