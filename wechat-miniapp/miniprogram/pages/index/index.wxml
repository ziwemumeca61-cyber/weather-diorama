<view class="app">
  <!-- 上半屏：3D 微缩城市（可手指拖拽转动镜头） -->
  <canvas
    type="webgl"
    id="gl"
    class="gl"
    hidden="{{moodOpen}}"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchEnd"
  ></canvas>

  <!-- 用于把预生成城市画面与实时天气、心情文案在本地合成为城市心情画报；不显示，不上传。 -->
  <canvas type="2d" id="weather-mood-canvas" class="mood-canvas"></canvas>

  <!-- 3D 初始化失败时的降级提示：天气信息仍可正常使用 -->
  <view class="glfail" wx:if="{{glFailed}}">
    <text class="glfail-e">🏙️</text>
    <text class="glfail-t">当前设备无法显示 3D 城市</text>
    <text class="glfail-s">天气信息仍可正常查看</text>
  </view>

  <!-- 昼夜切换（浮在画布右上角） -->
  <view class="daynight" wx:if="{{!glFailed && !moodOpen}}" bindtap="onToggleNight">{{night ? '🌙' : '☀️'}}</view>

  <!-- 下半屏：控制面板（普通 view，不与 canvas 重叠，一定可见） -->
  <view class="panel">
    <view class="grip"></view>
    <view class="summary">
      <view class="s-left">
        <view class="s-place-row">
          <text class="s-city">{{place}}</text>
          <text class="s-place-meta" wx:if="{{placeMeta}}">{{placeMeta}}</text>
        </view>
        <view class="s-kind-row">
          <text class="s-kind">{{emoji}} {{kindLabel}} · {{dateLabel}}</text>
          <view class="s-locate {{locating ? 'is-loading' : ''}}" catchtap="onLocate">
            <text>{{locating ? '定位中…' : '📍 定位区县'}}</text>
          </view>
        </view>
      </view>
      <text class="s-temp">{{temp}}°</text>
    </view>

    <view class="forecast-head" wx:if="{{hourly.length || forecast.length}}">
      <text class="forecast-title">{{forecastMode === 'hourly' ? '未来24小时' : '未来7日'}}</text>
      <view class="forecast-switch">
        <view class="forecast-switch-item {{forecastMode === 'hourly' ? 'on' : ''}}" data-mode="hourly" bindtap="onForecastMode">逐小时</view>
        <view class="forecast-switch-item {{forecastMode === 'daily' ? 'on' : ''}}" data-mode="daily" bindtap="onForecastMode">7日</view>
      </view>
    </view>

    <scroll-view class="fc" scroll-x enable-flex wx:if="{{forecastMode === 'hourly' && hourly.length}}">
      <view class="fc-item hourly-item" wx:for="{{hourly}}" wx:key="time">
        <text class="fc-d">{{item.label}}</text>
        <text class="fc-e">{{item.emoji}}</text>
        <text class="fc-hi">{{item.temp}}°</text>
        <text class="fc-weather">{{item.weatherLabel}}</text>
        <text class="fc-rain">{{item.rainLabel}}</text>
      </view>
    </scroll-view>

    <scroll-view class="fc" scroll-x enable-flex wx:elif="{{forecast.length}}">
      <view class="fc-item" wx:for="{{forecast}}" wx:key="label">
        <text class="fc-d">{{item.label}}</text>
        <text class="fc-e">{{item.emoji}}</text>
        <text class="fc-weather">{{item.weatherLabel}}</text>
        <text class="fc-hi">{{item.hi}}°</text>
        <text class="fc-lo">{{item.lo}}°</text>
      </view>
    </scroll-view>

    <view class="mood-entry" bindtap="onMoodToggle">
      <view class="mood-entry-copy">
        <view class="mood-entry-icon"><text>☁️</text></view>
        <view class="mood-entry-text">
          <text class="mood-entry-title">天气心情贴</text>
          <text class="mood-entry-sub">把此刻的天气和心情，留成一张贴</text>
        </view>
      </view>
      <view class="mood-entry-btn"><text>去制作</text><text class="mood-entry-arrow">›</text></view>
    </view>

    <view class="row">
      <input
        class="ipt"
        placeholder="搜索城市或区县，如黄浦区"
        placeholder-class="ph"
        confirm-type="search"
        value="{{q}}"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <view class="btn" bindtap="onSearch">搜索</view>
      <view class="btn ghost locate-btn {{locating ? 'is-loading' : ''}}" bindtap="onLocate">{{locating ? '定位中' : '定位'}}</view>
    </view>

    <view class="hint" wx:if="{{loading}}">加载中…</view>
    <view class="errbar" wx:elif="{{errMsg}}">
      <text class="err-t">{{errMsg}}</text>
      <view class="err-btn" bindtap="onRetry">重试</view>
    </view>

    <!-- Open-Meteo 为 CC-BY 4.0，署名必须在界面上可见 -->
    <view class="credit">
      <text class="credit-t">天气 Open-Meteo · 区县定位 腾讯位置服务 · 定位仅用于本地天气</text>
      <text class="credit-a" bindtap="onAbout">关于</text>
    </view>
  </view>

  <!-- 独立互动层：官方心情发布与心情画报分成两条清晰路径，避免混用。 -->
  <view class="mood-mask {{moodClosing ? 'mood-mask-closing' : ''}}" wx:if="{{moodOpen}}" bindtap="onMoodClose">
    <view class="mood-sheet {{moodClosing ? 'mood-sheet-closing' : 'mood-sheet-opening'}}" catchtap="onMoodSheetTap" bindanimationend="onMoodSheetAnimationEnd">
      <view class="mood-sheet-head" style="padding-top: {{moodSheetTopPx}}px;">
        <view class="mood-editor-close" catchtap="onMoodClose" aria-label="关闭天气心情贴">
          <text class="mood-editor-close-icon">×</text><text>关闭</text>
        </view>
        <view class="mood-sheet-copy">
          <text class="mood-sheet-eyebrow">WEATHER MOMENT</text>
          <text class="mood-sheet-title">把今天，贴进天气里</text>
          <text class="mood-sheet-sub">{{place}} · {{temp}}° · {{kindLabel}}</text>
        </view>
        <view class="mood-sheet-weather"><text>{{emoji}}</text></view>
      </view>

      <view class="mood-tabs" aria-label="选择操作">
        <view class="mood-tab {{moodTab === 'official' ? 'mood-tab-on' : ''}}" data-tab="official" bindtap="onMoodTab">心情动态</view>
        <view class="mood-tab {{moodTab === 'poster' ? 'mood-tab-on' : ''}}" data-tab="poster" bindtap="onMoodTab">✨ 心情画报</view>
      </view>

      <scroll-view
        class="mood-sheet-body"
        scroll-y
        enhanced
        show-scrollbar="{{true}}"
        scroll-top="{{moodScrollTop}}"
      >
        <view hidden="{{moodTab !== 'official'}}">
          <view class="mood-publish-area mood-publish-area-first">
            <view class="mood-publish-head">
              <view class="mood-publish-copy">
                <text class="mood-publish-title">发布天气心情</text>
                <text class="mood-publish-sub">从相册或相机添加照片 · 下方查看已发布内容</text>
              </view>
              <view class="mood-publish-head-right">
                <view class="mood-publish-action" bindtap="onOfficialPublishCommon">
                  <text class="mood-publish-action-icon">✎</text><text>发一条</text>
                </view>
                <text class="mood-publish-badge">官方</text>
              </view>
            </view>
            <view class="mood-official-unavailable" wx:if="{{!officialPublishEnabled}}">
              <text class="mood-official-unavailable-title">官方发表与已发内容仅支持手机微信</text>
              <text class="mood-official-unavailable-sub">请用 Android 或 iPhone 真机打开「发一条」</text>
            </view>
            <view class="mood-official-unavailable" wx:elif="{{!officialFeedMounted}}">
              <text class="mood-official-unavailable-title">贴图已发布，正在刷新社区</text>
              <text class="mood-official-unavailable-sub">稍等片刻即可查看刚发布的心情画报</text>
            </view>
            <official-account-publish
              wx:else
              topic="天气心情贴"
              limit="10"
              placeholder="说说此刻的天气和心情…"
              background-color="#f6f8fc"
              color-unity="{{true}}"
              show-related="{{true}}"
              recommend-path="/pages/index/index"
              recommend-title="云上幻象天气 · 发布天气心情"
              binderror="onMoodComponentError"
              bindpublishsuccess="onMoodComponentPublishSuccess"
              bindpublishfail="onMoodComponentPublishFail"
            ></official-account-publish>
          </view>
        </view>

        <view wx:if="{{moodTab === 'poster'}}">
          <view class="mood-section">
            <view class="mood-section-head">
              <text class="mood-section-title">此刻的心情</text>
              <text class="mood-section-state">第一步</text>
            </view>
            <scroll-view class="mood-options" scroll-x enable-flex>
              <view
                wx:for="{{moodOptions}}"
                wx:key="key"
                class="mood-option {{moodKey === item.key ? 'mood-option-on' : ''}}"
                data-key="{{item.key}}"
                bindtap="onMoodPick"
              ><text class="mood-option-emoji">{{item.emoji}}</text><text>{{item.label}}</text></view>
            </scroll-view>
          </view>

          <view class="mood-section-head mood-style-head">
            <text class="mood-section-title">选择画面风格</text>
            <text class="mood-section-tip">第二步 · 只匹配所选风格</text>
          </view>
          <scroll-view class="mood-styles" scroll-x enable-flex>
            <view
              wx:for="{{moodStyles}}"
              wx:key="key"
              class="mood-style {{moodStyleKey === item.key ? 'mood-style-on' : ''}}"
              data-key="{{item.key}}"
              bindtap="onMoodStylePick"
            >
              <text class="mood-style-name">{{item.emoji}} {{item.label}}</text>
              <text class="mood-style-sub">{{item.copy}}</text>
            </view>
          </scroll-view>

          <view class="mood-writing">
            <view class="mood-writing-head"><text>写给今天的话</text><text>第三步 · 选填</text></view>
            <textarea
              class="mood-textarea"
              value="{{moodText}}"
              maxlength="80"
              placeholder="例如：云散以后，也记得抬头看看。"
              placeholder-class="mood-placeholder"
              auto-height
              bindinput="onMoodText"
              bindblur="onMoodTextCommit"
            />
          </view>

          <view class="mood-main-action {{!moodAssetEnabled ? 'mood-main-disabled' : ''}}" bindtap="onUseMoodAsset">
            <text class="mood-action-icon">{{moodLoading ? '◌' : '✦'}}</text>
            <text>{{moodLoading ? '正在制作城市心情画报…' : moodAssetEnabled ? '制作城市心情画报' : '城市心情画报暂不可用'}}</text>
          </view>

          <view class="mood-preview-wrap" wx:if="{{moodPreview || moodLoading}}">
            <image class="mood-preview" wx:if="{{moodPreview}}" src="{{moodPreview}}" mode="aspectFill" />
            <view class="mood-preview-empty" wx:else>
              <text class="mood-preview-emoji">✨</text>
              <text class="mood-preview-title">正在制作城市心情画报</text>
              <text class="mood-preview-sub">载入城市画面后，在本地叠加实时天气与文字</text>
            </view>
          </view>

          <text class="mood-ai-note" wx:if="{{moodPreview}}">背景来自已匹配的城市与画面风格；实时天气与文字只在本地叠加。</text>

          <view class="mood-ready" wx:if="{{moodPreview}}">
            <view class="mood-ready-title"><text>城市心情画报已准备好</text><text>保存或发布</text></view>
            <view class="mood-ready-row">
              <view class="mood-secondary" bindtap="onSaveMoodSticker">保存图片</view>
              <view class="mood-secondary" bindtap="onCopyMoodArticle">复制图文</view>
            </view>
            <view class="mood-source-publish mood-poster-publish" bindtap="onOfficialPublishPoster">
              <text>✎</text><text>一键发布心情画报</text>
            </view>
          </view>
        </view>

        <text class="mood-privacy" wx:if="{{moodTab === 'official'}}">照片选择、文字编辑与发布均在微信官方发表页完成。</text>
        <text class="mood-privacy" wx:else>城市画面、实时天气和文字在本机合成为心情画报；背景从预生成云素材库读取。</text>
      </scroll-view>
    </view>
  </view>
</view>
