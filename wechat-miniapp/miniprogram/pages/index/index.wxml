<view class="app">
  <!-- 上半屏：3D 微缩城市（可手指拖拽转动镜头） -->
  <canvas
    type="webgl"
    id="gl"
    class="gl"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchEnd"
  ></canvas>

  <!-- 3D 初始化失败时的降级提示：天气信息仍可正常使用 -->
  <view class="glfail" wx:if="{{glFailed}}">
    <text class="glfail-e">🏙️</text>
    <text class="glfail-t">当前设备无法显示 3D 城市</text>
    <text class="glfail-s">天气信息仍可正常查看</text>
  </view>

  <!-- 昼夜切换（浮在画布右上角） -->
  <view class="daynight" wx:if="{{!glFailed}}" bindtap="onToggleNight">{{night ? '🌙' : '☀️'}}</view>

  <!-- 下半屏：控制面板（普通 view，不与 canvas 重叠，一定可见） -->
  <view class="panel">
    <view class="grip"></view>
    <view class="summary">
      <view class="s-left">
        <text class="s-city">{{place}}</text>
        <text class="s-kind">{{emoji}} {{kindLabel}} · {{dateLabel}}</text>
      </view>
      <text class="s-temp">{{temp}}°</text>
    </view>

    <!-- 七天预报（云函数早就返回了 daily，之前一直没用上） -->
    <scroll-view class="fc" scroll-x enable-flex wx:if="{{forecast.length}}">
      <view class="fc-item" wx:for="{{forecast}}" wx:key="label">
        <text class="fc-d">{{item.label}}</text>
        <text class="fc-e">{{item.emoji}}</text>
        <text class="fc-hi">{{item.hi}}°</text>
        <text class="fc-lo">{{item.lo}}°</text>
      </view>
    </scroll-view>

    <view class="row">
      <input
        class="ipt"
        placeholder="搜索城市，或输入天气问题"
        placeholder-class="ph"
        confirm-type="search"
        value="{{q}}"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <view class="btn" bindtap="onSearch">搜索</view>
      <view class="btn ghost" bindtap="onLocate">📍</view>
    </view>

    <view class="ai-actions">
      <view class="ai-action ai-primary" bindtap="onAiAdvice">
        <text class="ai-icon">✦</text>
        <view class="ai-action-copy">
          <text class="ai-action-title">AI管家</text>
          <text class="ai-action-sub">今天怎么安排</text>
        </view>
      </view>
      <view class="ai-action" bindtap="onAiAsk">
        <text class="ai-icon">?</text>
        <view class="ai-action-copy">
          <text class="ai-action-title">问天气</text>
          <text class="ai-action-sub">自然语言提问</text>
        </view>
      </view>
      <view class="ai-action" bindtap="onAiShare">
        <text class="ai-icon">↗</text>
        <view class="ai-action-copy">
          <text class="ai-action-title">AI文案</text>
          <text class="ai-action-sub">一键生成分享</text>
        </view>
      </view>
    </view>
    <scroll-view class="chips" scroll-x enable-flex>
      <view
        wx:for="{{kinds}}"
        wx:key="*this"
        class="chip {{item === curKind ? 'on' : ''}}"
        data-k="{{item}}"
        bindtap="onChip"
      >{{labels[item]}}</view>
    </scroll-view>

    <view class="ai-card" wx:if="{{aiVisible}}">
      <view class="ai-card-head">
        <view class="ai-card-heading">
          <text class="ai-eyebrow">AI WEATHER</text>
          <text class="ai-card-title">{{aiTitle}}</text>
        </view>
        <text class="ai-close" bindtap="onAiClose">×</text>
      </view>
      <text class="ai-card-text">{{aiText}}</text>
      <view class="ai-points" wx:if="{{aiPoints.length}}">
        <view class="ai-point" wx:for="{{aiPoints}}" wx:key="*this">
          <text class="ai-point-dot">•</text>
          <text class="ai-point-text">{{item}}</text>
        </view>
      </view>
      <view class="ai-tags" wx:if="{{aiTags.length}}">
        <text class="ai-score" wx:if="{{aiScoreLabel}}">{{aiScoreLabel}}</text>
        <text class="ai-tag" wx:for="{{aiTags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="ai-card-foot">
        <text class="ai-source">{{aiSourceLabel}}</text>
        <view class="ai-copy" bindtap="onCopyAi">复制结果</view>
      </view>
    </view>
    <view class="hint" wx:if="{{loading}}">加载中…</view>
    <view class="errbar" wx:elif="{{errMsg}}">
      <text class="err-t">{{errMsg}}</text>
      <view class="err-btn" bindtap="onRetry">重试</view>
    </view>

    <!-- Open-Meteo 为 CC-BY 4.0，署名必须在界面上可见 -->
    <view class="credit">
      <text class="credit-t">天气数据 Open-Meteo (CC-BY 4.0) · 定位仅用于查询本地天气</text>
      <text class="credit-a" bindtap="onAbout">关于</text>
    </view>
  </view>
</view>
