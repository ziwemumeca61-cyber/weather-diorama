<view class="app">
  <!-- 上半屏：3D 微缩城市（可手指拖拽转动镜头） -->
  <canvas
    type="webgl"
    id="gl"
    class="gl"
    bindtouchstart="onCanvasTouchStart"
    bindtouchmove="onCanvasTouchMove"
    bindtouchend="onCanvasTouchEnd"
    bindtouchcancel="onCanvasTouchEnd"
  ></canvas>

  <!-- 用于把本地照片 / AI 背景与天气心情本地合成；不显示，不上传。 -->
  <canvas type="2d" id="weather-mood-canvas" class="mood-canvas"></canvas>

  <!-- 3D 初始化失败时的降级提示：天气信息仍可正常使用 -->
  <view class="glfail" wx:if="{{glFailed}}">
    <text class="glfail-e">🏙️</text>
    <text class="glfail-t">当前设备无法显示 3D 城市</text>
    <text class="glfail-s">天气信息仍可正常查看</text>
  </view>

  <!-- 昼夜切换（浮在画布右上角） -->
  <view class="daynight" wx:if="{{!glFailed}}" bindtap="onToggleNight">{{night ? '🌙' : '☀️'}}</view>

  <!-- 下半屏：控制面板（普通 view，不与 canvas 重叠，一定可见） -->
  <view class="panel">
    <view class="grip"></view>
    <view class="summary">
      <view class="s-left">
        <text class="s-city">{{place}}</text>
        <text class="s-kind">{{emoji}} {{kindLabel}} · {{dateLabel}}</text>
      </view>
      <text class="s-temp">{{temp}}°</text>
    </view>

    <!-- 七天预报（云函数早就返回了 daily，之前一直没用上） -->
    <scroll-view class="fc" scroll-x enable-flex wx:if="{{forecast.length}}">
      <view class="fc-item" wx:for="{{forecast}}" wx:key="label">
        <text class="fc-d">{{item.label}}</text>
        <text class="fc-e">{{item.emoji}}</text>
        <text class="fc-hi">{{item.hi}}°</text>
        <text class="fc-lo">{{item.lo}}°</text>
      </view>
    </scroll-view>

    <view class="mood-entry" bindtap="onMoodToggle">
      <view class="mood-entry-copy">
        <text class="mood-entry-icon">💭</text>
        <view class="mood-entry-text">
          <text class="mood-entry-title">天气心情贴</text>
          <text class="mood-entry-sub">把天气、照片和此刻心情发成一篇图文</text>
        </view>
      </view>
      <text class="mood-entry-btn">去制作</text>
    </view>

    <!-- AI 先做成审核安全的可开关模块：默认关闭，开启后只有用户主动点击才调用额度。 -->
    <view class="ai-entry" wx:if="{{aiEnabled}}">
      <view class="ai-entry-copy">
        <text class="ai-entry-icon">☁️</text>
        <view class="ai-entry-text">
          <text class="ai-entry-title">AI天气助手</text>
          <text class="ai-entry-sub">看天气、问出行、生成分享文案，一个入口解决</text>
        </view>
      </view>
      <view class="ai-entry-btn" bindtap="onAiToggle">{{aiOpen ? '收起' : '打开'}}</view>
    </view>

    <view class="ai-panel" wx:if="{{aiEnabled && aiOpen}}">
      <view class="ai-panel-head">
        <text class="ai-panel-title">今天想问什么？</text>
        <text class="ai-panel-note">只在你点击提问时调用</text>
      </view>
      <view class="ai-prompts">
        <view class="ai-prompt" wx:for="{{aiPrompts}}" wx:key="*this" data-q="{{item}}" bindtap="onAiPrompt">{{item}}</view>
      </view>
      <view class="ai-ask-row">
        <input
          class="ai-input"
          placeholder="例如：周末适合去海边吗？"
          placeholder-class="ph"
          maxlength="200"
          value="{{aiQuestion}}"
          bindinput="onAiInput"
          bindconfirm="onAiAsk"
        />
        <view class="ai-ask-btn" bindtap="onAiAsk">{{aiLoading ? '分析中' : '提问'}}</view>
      </view>
      <view class="ai-result" wx:if="{{aiLoading || aiText}}">
        <text class="ai-result-text">{{aiLoading ? '正在结合当前天气分析…' : aiText}}</text>
        <text class="ai-cache" wx:if="{{aiCacheHint}}">{{aiCacheHint}}</text>
        <view class="ai-copy" wx:if="{{aiText}}" bindtap="onAiCopy">复制结果</view>
      </view>
      <text class="ai-disclaimer">AI 建议仅作日常参考，雷雨、大风等情况以官方预警为准。</text>
    </view>

    <view class="row">
      <input
        class="ipt"
        placeholder="搜索城市，如上海/北京"
        placeholder-class="ph"
        confirm-type="search"
        value="{{q}}"
        bindinput="onInput"
        bindconfirm="onSearch"
      />
      <view class="btn" bindtap="onSearch">搜索</view>
      <view class="btn ghost" bindtap="onLocate">📍</view>
    </view>

    <view class="hint" wx:if="{{loading}}">加载中…</view>
    <view class="errbar" wx:elif="{{errMsg}}">
      <text class="err-t">{{errMsg}}</text>
      <view class="err-btn" bindtap="onRetry">重试</view>
    </view>

    <!-- Open-Meteo 为 CC-BY 4.0，署名必须在界面上可见 -->
    <view class="credit">
      <text class="credit-t">天气数据 Open-Meteo (CC-BY 4.0) · 定位仅用于查询本地天气</text>
      <text class="credit-a" bindtap="onAbout">关于</text>
    </view>
  </view>

  <!-- 独立制作层：避免把主页挤得很长，图片始终由用户主动选择或主动生成。 -->
  <view class="mood-mask" wx:if="{{moodOpen}}">
    <scroll-view class="mood-sheet" scroll-y>
      <view class="mood-sheet-head">
        <view>
          <text class="mood-sheet-title">今天想怎么表达？</text>
          <text class="mood-sheet-sub">天气是背景，心情才是主角</text>
        </view>
        <text class="mood-close" bindtap="onMoodClose">×</text>
      </view>

      <view class="mood-tabs">
        <view class="mood-tab {{moodTab === 'photo' ? 'mood-tab-on' : ''}}" data-tab="photo" bindtap="onMoodTab">我的照片</view>
        <view class="mood-tab {{moodTab === 'ai' ? 'mood-tab-on' : ''}}" data-tab="ai" bindtap="onMoodTab">AI 心情贴</view>
      </view>

      <scroll-view class="mood-options" scroll-x enable-flex>
        <view
          wx:for="{{moodOptions}}"
          wx:key="key"
          class="mood-option {{moodKey === item.key ? 'mood-option-on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onMoodPick"
        >{{item.emoji}} {{item.label}}</view>
      </scroll-view>

      <textarea
        class="mood-textarea"
        value="{{moodText}}"
        maxlength="80"
        placeholder="写一句今天想说的话（可不写）"
        placeholder-class="mood-placeholder"
        auto-height
        bindinput="onMoodText"
      />

      <view class="mood-preview-wrap">
        <image class="mood-preview" wx:if="{{moodPreview}}" src="{{moodPreview}}" mode="aspectFill" />
        <view class="mood-preview-empty" wx:else>
          <text class="mood-preview-emoji">{{moodTab === 'photo' ? '📷' : '✨'}}</text>
          <text>{{moodLoading ? '正在把心情变成一张图…' : moodTab === 'photo' ? '选择一张照片，天气会贴上去' : '选好心情后，生成专属氛围图'}}</text>
        </view>
      </view>

      <view class="mood-main-action" wx:if="{{moodTab === 'photo'}}" bindtap="onChooseMoodPhoto">
        {{moodLoading ? '正在合成…' : moodPhoto ? '换一张照片' : '从相册选择 / 现在拍照'}}
      </view>
      <view class="mood-main-action {{!aiEnabled ? 'mood-main-disabled' : ''}}" wx:else bindtap="onGenerateAiMood">
        {{moodLoading ? 'AI 正在生成…' : aiEnabled ? '生成 AI 心情贴' : '审核通过后开放 AI 心情贴'}}
      </view>

      <view class="mood-ready" wx:if="{{moodPreview}}">
        <view class="mood-ready-row">
          <view class="mood-secondary" bindtap="onSaveMoodSticker">保存图片</view>
          <view class="mood-secondary" bindtap="onCopyMoodArticle">复制图文</view>
        </view>
        <text class="mood-ready-note">先保存这张图；进入发布器后，从相册选择它并粘贴文案。</text>
        <official-account-publish topic="{{publishTopic}}" background-color="#405b9d"></official-account-publish>
      </view>

      <text class="mood-privacy">本地照片只在手机上合成，不会上传；AI 图仅在你主动点击生成时使用成长计划额度。</text>
    </scroll-view>
  </view>
</view>
