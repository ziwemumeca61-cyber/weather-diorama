<view class="app">
  <!-- 3D 微缩城市（原生 canvas，会盖住普通 view，所以上面的 UI 用 cover-view） -->
  <canvas type="webgl" id="gl" class="gl"></canvas>

  <!-- 顶部天气卡 -->
  <cover-view class="card">
    <cover-view class="pill">
      <cover-view class="city">{{place}}</cover-view>
      <cover-view class="emoji">{{emoji}}</cover-view>
      <cover-view class="temp">{{temp}}°</cover-view>
      <cover-view class="kind">{{kindLabel}} · {{dateLabel}}</cover-view>
    </cover-view>
  </cover-view>

  <!-- 底部控制 -->
  <cover-view class="hud">
    <cover-view class="row">
      <cover-view class="btn locate" bindtap="onLocate">📍 定位</cover-view>
      <cover-view
        wx:for="{{cities}}"
        wx:key="*this"
        class="btn {{item === place ? 'on' : ''}}"
        data-c="{{item}}"
        bindtap="onCity"
      >{{item}}</cover-view>
    </cover-view>
    <cover-view class="row chips">
      <cover-view
        wx:for="{{kinds}}"
        wx:key="*this"
        class="chip {{item === curKind ? 'on' : ''}}"
        data-k="{{item}}"
        bindtap="onChip"
      >{{labels[item]}}</cover-view>
    </cover-view>
  </cover-view>

  <cover-view class="loading" wx:if="{{loading}}">加载中…</cover-view>
</view>
