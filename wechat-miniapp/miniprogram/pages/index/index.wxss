.app {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #0b1220;
}

/* 上半屏 3D 画布 */
.gl {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* 昼夜切换按钮：避开微信右上角原生胶囊，固定在画布右侧安全区下方 */
.daynight {
  position: absolute;
  top: calc(168rpx + env(safe-area-inset-top));
  right: 30rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 38rpx;
  border-radius: 999rpx;
  background: rgba(12, 20, 38, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 下半屏控制面板：深色磨砂玻璃卡片（圆角上翻，不与 canvas 重叠） */
.panel {
  flex: none;
  padding: 8rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #18233c 0%, #0e1626 100%);
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.45);
}
.grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 14rpx auto 22rpx;
}

.summary {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 26rpx;
}
.s-left {
  display: flex;
  flex-direction: column;
}
.s-city {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.s-kind {
  font-size: 26rpx;
  color: #9fb0c8;
  margin-top: 8rpx;
}
.s-temp {
  font-size: 96rpx;
  font-weight: 200;
  color: #ffffff;
  line-height: 1;
}

/* 七天预报横条 */
.fc {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 22rpx;
}
.fc-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 104rpx;
  padding: 16rpx 8rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.07);
}
.fc-d {
  font-size: 22rpx;
  color: #9fb0c8;
}
.fc-e {
  font-size: 34rpx;
  margin: 8rpx 0 6rpx;
}
.fc-hi {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}
.fc-lo {
  font-size: 22rpx;
  color: #7c88a0;
  margin-top: 2rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.ipt {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 28rpx;
}
.ph {
  color: #7c88a0;
}
.btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  color: #ffffff;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.35);
}
.btn.ghost {
  background: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.chips {
  white-space: nowrap;
  width: 100%;
}
.chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #c3cde0;
  font-size: 26rpx;
}
.chip.on {
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.4);
}
/* AI 三个入口：管家、自然语言提问、分享文案 */
.ai-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin: 2rpx 0 20rpx;
}
.ai-action {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.065);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
}
.ai-action.ai-primary {
  background: linear-gradient(135deg, #315fae, #477ed0);
  border-color: transparent;
}
.ai-icon {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 25rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
}
.ai-action-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 8rpx;
}
.ai-action-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
}
.ai-action-sub {
  overflow: hidden;
  margin-top: 3rpx;
  color: rgba(220, 231, 249, 0.72);
  font-size: 18rpx;
  white-space: nowrap;
}

.ai-card {
  margin: 0 0 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(45, 78, 136, 0.72), rgba(23, 35, 61, 0.94));
  border: 2rpx solid rgba(126, 174, 255, 0.22);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.2);
}
.ai-card-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}
.ai-card-heading {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.ai-eyebrow {
  color: #8fc0ff;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}
.ai-card-title {
  display: block;
  margin-top: 5rpx;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 600;
}
.ai-close {
  flex: none;
  margin: -8rpx -8rpx 0 12rpx;
  padding: 0 8rpx;
  color: #9dadc5;
  font-size: 40rpx;
  line-height: 44rpx;
}
.ai-card-text {
  display: block;
  margin-top: 16rpx;
  color: #ecf2fc;
  font-size: 27rpx;
  line-height: 1.55;
}
.ai-points {
  margin-top: 10rpx;
}
.ai-point {
  display: flex;
  flex-direction: row;
  margin-top: 8rpx;
  color: #c2d0e4;
  font-size: 23rpx;
  line-height: 1.45;
}
.ai-point-dot {
  flex: none;
  margin-right: 8rpx;
  color: #86baff;
}
.ai-point-text {
  flex: 1;
}
.ai-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.ai-score,
.ai-tag {
  margin: 0 8rpx 6rpx 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #dce9ff;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.1);
}
.ai-score {
  color: #ffffff;
  background: rgba(96, 161, 255, 0.38);
}
.ai-card-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.ai-source {
  color: #8fa5c3;
  font-size: 19rpx;
}
.ai-copy {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  color: #dce9ff;
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.1);
}

.hint {
  margin-top: 14rpx;
  text-align: center;
  color: #9fb0c8;
  font-size: 26rpx;
}

/* 署名（Open-Meteo CC-BY 4.0 要求界面可见）+ 关于入口 */
.credit {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}
.credit-t {
  font-size: 20rpx;
  color: #6b788c;
}
.credit-a {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #7f9ec4;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
}

/* 加载失败重试 */
.errbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}
.err-t {
  font-size: 26rpx;
  color: #e0908a;
}
.err-btn {
  margin-left: 16rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

/* 3D 不可用时的降级占位 */
.glfail {
  position: absolute;
  left: 0;
  right: 0;
  top: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.glfail-e {
  font-size: 96rpx;
  opacity: 0.5;
}
.glfail-t {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #c3cde0;
}
.glfail-s {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c88a0;
}
