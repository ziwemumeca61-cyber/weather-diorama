.app {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #0b1220;
}

/* 上半屏 3D 画布 */
.gl {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* 2D 合成画布在屏幕外保留节点；所有图片合成均在本地执行。 */
.mood-canvas {
  position: fixed;
  left: -2000rpx;
  top: -2000rpx;
  width: 2rpx;
  height: 2rpx;
  opacity: 0;
  pointer-events: none;
}

/* 昼夜切换按钮：避开微信右上角原生胶囊，固定在画布右侧安全区下方 */
.daynight {
  position: absolute;
  top: calc(168rpx + env(safe-area-inset-top));
  right: 30rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 38rpx;
  border-radius: 999rpx;
  background: rgba(12, 20, 38, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 下半屏控制面板：深色磨砂玻璃卡片（圆角上翻，不与 canvas 重叠） */
.panel {
  flex: none;
  padding: 8rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #18233c 0%, #0e1626 100%);
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.45);
}
.grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 14rpx auto 22rpx;
}

.summary {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 26rpx;
}
.s-left {
  display: flex;
  flex-direction: column;
}
.s-city {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.s-kind {
  font-size: 26rpx;
  color: #9fb0c8;
  margin-top: 8rpx;
}
.s-temp {
  font-size: 96rpx;
  font-weight: 200;
  color: #ffffff;
  line-height: 1;
}

/* 七天预报横条 */
.fc {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 22rpx;
}
.fc-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 104rpx;
  padding: 16rpx 8rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.07);
}
.fc-d {
  font-size: 22rpx;
  color: #9fb0c8;
}
.fc-e {
  font-size: 34rpx;
  margin: 8rpx 0 6rpx;
}
.fc-hi {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}
.fc-lo {
  font-size: 22rpx;
  color: #7c88a0;
  margin-top: 2rpx;
}

/* 首页入口不直接展示复杂编辑，点击后以独立制作层呈现。 */
.mood-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 2rpx 0 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(217, 113, 126, 0.28), rgba(80, 81, 151, 0.42));
  border: 2rpx solid rgba(255, 190, 197, 0.2);
}
.mood-entry-copy {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}
.mood-entry-icon {
  margin-right: 14rpx;
  font-size: 38rpx;
}
.mood-entry-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.mood-entry-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.mood-entry-sub {
  margin-top: 5rpx;
  color: #d5c5d7;
  font-size: 21rpx;
  white-space: nowrap;
}
.mood-entry-btn {
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 23rpx;
  background: linear-gradient(135deg, #de6e74, #a265bd);
  box-shadow: 0 5rpx 15rpx rgba(193, 90, 128, 0.26);
}

.mood-mask {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  background: rgba(3, 8, 19, 0.66);
}
.mood-mask-closing {
  animation: mood-mask-out 260ms ease-out forwards;
}
.mood-sheet {
  position: absolute;
  z-index: 1;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 38rpx 38rpx 0 0;
  background: linear-gradient(180deg, #202b49 0%, #10182a 100%);
  box-shadow: 0 -20rpx 60rpx rgba(0, 0, 0, 0.45);
}
.mood-sheet-opening {
  animation: mood-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.32, 1) both;
}
.mood-sheet-closing {
  pointer-events: none;
  animation: mood-sheet-out 260ms cubic-bezier(0.4, 0, 1, 1) forwards;
}
.mood-sheet-head {
  box-sizing: border-box;
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 122rpx;
  padding: 30rpx 126rpx 20rpx 30rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
  background: #202b49;
}
.mood-sheet-body {
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  width: 100%;
  padding: 0 30rpx calc(30rpx + env(safe-area-inset-bottom));
}
.mood-sheet-title {
  display: block;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}
.mood-sheet-sub {
  display: block;
  margin-top: 8rpx;
  color: #9eafca;
  font-size: 23rpx;
}
.mood-close-float {
  position: fixed;
  z-index: 30;
  right: 24rpx;
  box-sizing: border-box;
  width: 68rpx;
  height: 68rpx;
  line-height: 64rpx;
  text-align: center;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  color: #ced7e8;
  font-size: 44rpx;
  font-weight: 200;
  background: rgba(255, 255, 255, 0.07);
}
.mood-close-closing {
  pointer-events: none;
  animation: mood-close-out 160ms ease-out forwards;
}

@keyframes mood-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes mood-sheet-out {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

@keyframes mood-mask-out {
  from { background: rgba(3, 8, 19, 0.66); }
  to { background: rgba(3, 8, 19, 0); }
}

@keyframes mood-close-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
.mood-publish-entry {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(139, 177, 242, 0.25);
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(70, 111, 190, 0.28), rgba(75, 74, 142, 0.34));
}
.mood-publish-copy {
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}
.mood-publish-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.mood-publish-sub,
.mood-publish-tip {
  color: #aebbd1;
  font-size: 21rpx;
  line-height: 1.55;
}
.mood-publish-sub {
  margin-top: 6rpx;
}
.mood-publish-tip {
  display: block;
  margin-top: 12rpx;
}
.mood-tabs {
  display: flex;
  flex-direction: row;
  margin-top: 26rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
}
.mood-tab {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 15rpx;
  text-align: center;
  color: #a9b5cc;
  font-size: 26rpx;
}
.mood-tab-on {
  color: #ffffff;
  font-weight: 600;
  background: rgba(224, 121, 137, 0.38);
}
.mood-options {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}
.mood-option {
  display: inline-block;
  margin-right: 12rpx;
  padding: 13rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 999rpx;
  color: #c8d1e1;
  font-size: 23rpx;
  background: rgba(255, 255, 255, 0.05);
}
.mood-option-on {
  border-color: rgba(255, 194, 203, 0.52);
  color: #fff0f1;
  background: rgba(218, 105, 127, 0.34);
}
.mood-section-label {
  display: block;
  margin-top: 22rpx;
  color: #9eafca;
  font-size: 22rpx;
}
.mood-styles {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}
.mood-style {
  box-sizing: border-box;
  display: inline-flex;
  flex-direction: column;
  width: 250rpx;
  margin-right: 14rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
}
.mood-style-on {
  border-color: rgba(255, 194, 203, 0.52);
  background: linear-gradient(135deg, rgba(218, 105, 127, 0.3), rgba(123, 91, 175, 0.28));
}
.mood-style-name {
  color: #f8edf1;
  font-size: 24rpx;
  font-weight: 600;
}
.mood-style-sub {
  margin-top: 7rpx;
  color: #9eafca;
  font-size: 19rpx;
  line-height: 1.45;
  white-space: normal;
}
.mood-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 92rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1.55;
  background: rgba(7, 14, 29, 0.44);
}
.mood-placeholder {
  color: #718099;
}
.mood-preview-wrap {
  margin-top: 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  background: #0b1120;
}
.mood-preview,
.mood-preview-empty {
  display: flex;
  width: 100%;
  height: 410rpx;
}
.mood-preview {
  object-fit: cover;
}
.mood-preview-empty {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #a7b3c8;
  font-size: 25rpx;
  background: radial-gradient(circle at 50% 12%, #4d597e 0%, #1c263f 38%, #0e1527 100%);
}
.mood-preview-emoji {
  margin-bottom: 18rpx;
  font-size: 74rpx;
}
.mood-main-action {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #db6e79, #8d65ba);
  box-shadow: 0 8rpx 22rpx rgba(177, 80, 129, 0.28);
}
.mood-main-disabled {
  color: rgba(255, 255, 255, 0.62);
  background: rgba(255, 255, 255, 0.1);
  box-shadow: none;
}
.mood-ai-note {
  display: block;
  margin-top: 14rpx;
  color: #9eafca;
  font-size: 21rpx;
  line-height: 1.55;
}
.mood-ready {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(255, 201, 206, 0.18);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.055);
}
.mood-ready-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 14rpx;
}
.mood-secondary {
  flex: 1;
  padding: 16rpx 0;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 999rpx;
  text-align: center;
  color: #f5d6dd;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.08);
}
.mood-ready-note,
.mood-privacy {
  display: block;
  margin-top: 14rpx;
  color: #8b9ab3;
  font-size: 21rpx;
  line-height: 1.55;
}
.mood-privacy {
  margin: 20rpx 2rpx 0;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.ipt {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 28rpx;
}
.ph {
  color: #7c88a0;
}
.btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  color: #ffffff;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.35);
}
.btn.ghost {
  background: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.chips {
  white-space: nowrap;
  width: 100%;
}
.chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #c3cde0;
  font-size: 26rpx;
}
.chip.on {
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.4);
}
.hint {
  margin-top: 14rpx;
  text-align: center;
  color: #9fb0c8;
  font-size: 26rpx;
}

/* 署名（Open-Meteo CC-BY 4.0 要求界面可见）+ 关于入口 */
.credit {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}
.credit-t {
  font-size: 20rpx;
  color: #6b788c;
}
.credit-a {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #7f9ec4;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
}

/* 加载失败重试 */
.errbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}
.err-t {
  font-size: 26rpx;
  color: #e0908a;
}
.err-btn {
  margin-left: 16rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

/* 3D 不可用时的降级占位 */
.glfail {
  position: absolute;
  left: 0;
  right: 0;
  top: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.glfail-e {
  font-size: 96rpx;
  opacity: 0.5;
}
.glfail-t {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #c3cde0;
}
.glfail-s {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c88a0;
}
