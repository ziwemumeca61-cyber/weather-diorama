.app {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #0b1220;
}

/* 上半屏 3D 画布 */
.gl {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* 2D 合成画布在屏幕外保留节点；所有图片合成均在本地执行。 */
.mood-canvas {
  position: fixed;
  left: -2000rpx;
  top: -2000rpx;
  width: 2rpx;
  height: 2rpx;
  opacity: 0;
  pointer-events: none;
}

/* 昼夜切换按钮：避开微信右上角原生胶囊，固定在画布右侧安全区下方 */
.daynight {
  position: absolute;
  top: calc(168rpx + env(safe-area-inset-top));
  right: 30rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 38rpx;
  border-radius: 999rpx;
  background: rgba(12, 20, 38, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 下半屏控制面板：深色磨砂玻璃卡片（圆角上翻，不与 canvas 重叠） */
.panel {
  flex: none;
  padding: 8rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #18233c 0%, #0e1626 100%);
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.45);
}
.grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 14rpx auto 22rpx;
}

.summary {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 26rpx;
}
.s-left {
  display: flex;
  flex-direction: column;
}
.s-city {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.s-kind {
  font-size: 26rpx;
  color: #9fb0c8;
  margin-top: 8rpx;
}
.s-temp {
  font-size: 96rpx;
  font-weight: 200;
  color: #ffffff;
  line-height: 1;
}

/* 七天预报横条 */
.fc {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 22rpx;
}
.fc-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 104rpx;
  padding: 16rpx 8rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.07);
}
.fc-d {
  font-size: 22rpx;
  color: #9fb0c8;
}
.fc-e {
  font-size: 34rpx;
  margin: 8rpx 0 6rpx;
}
.fc-hi {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}
.fc-lo {
  font-size: 22rpx;
  color: #7c88a0;
  margin-top: 2rpx;
}

/* 天气心情贴：亮色、轻量的制作页；官方「发一条」组件保持原生。 */
.mood-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 2rpx 0 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 26rpx;
  background: linear-gradient(120deg, rgba(126, 163, 255, 0.3), rgba(175, 129, 238, 0.35));
  border: 2rpx solid rgba(226, 237, 255, 0.24);
}
.mood-entry-copy {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}
.mood-entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.16);
}
.mood-entry-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.mood-entry-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.mood-entry-sub {
  margin-top: 5rpx;
  color: #dce7ff;
  font-size: 21rpx;
  white-space: nowrap;
}
.mood-entry-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 23rpx;
  color: #314b88;
  background: #ffffff;
  box-shadow: 0 5rpx 15rpx rgba(22, 42, 96, 0.18);
}
.mood-entry-arrow { font-size: 30rpx; line-height: 1; }

.mood-mask {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  background: rgba(17, 31, 57, 0.52);
}
.mood-mask-closing {
  animation: mood-mask-out 260ms ease-out forwards;
}
.mood-sheet {
  position: absolute;
  z-index: 1;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 40rpx 40rpx 0 0;
  background: #f6f8fc;
  box-shadow: 0 -20rpx 60rpx rgba(18, 35, 69, 0.28);
}
.mood-sheet-opening {
  animation: mood-sheet-in 240ms cubic-bezier(0.22, 0.8, 0.32, 1) both;
}
.mood-sheet-closing {
  pointer-events: none;
  animation: mood-sheet-out 260ms cubic-bezier(0.4, 0, 1, 1) forwards;
}
.mood-sheet-head {
  box-sizing: border-box;
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 140rpx;
  padding: 28rpx 128rpx 26rpx 32rpx;
  border-bottom: 2rpx solid #e8edf6;
  background: linear-gradient(135deg, #ffffff 0%, #edf4ff 100%);
}
.mood-sheet-copy { display: flex; flex-direction: column; }
.mood-sheet-eyebrow { color: #6e86b5; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.mood-sheet-body {
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
  padding: 0 28rpx calc(34rpx + env(safe-area-inset-bottom));
}
.mood-sheet-title {
  display: block;
  margin-top: 6rpx;
  color: #17233b;
  font-size: 38rpx;
  font-weight: 700;
}
.mood-sheet-sub {
  display: block;
  margin-top: 8rpx;
  color: #6b7d9f;
  font-size: 22rpx;
}
.mood-sheet-weather { position: absolute; right: 116rpx; top: 43rpx; display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border-radius: 24rpx; font-size: 38rpx; background: #ffffff; box-shadow: 0 8rpx 22rpx rgba(85, 117, 175, 0.14); }
.mood-close-float {
  position: fixed;
  z-index: 30;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 72rpx;
  height: 72rpx;
  line-height: 1;
  text-align: center;
  border: 2rpx solid rgba(65, 92, 141, 0.18);
  border-radius: 999rpx;
  color: #304b78;
  font-size: 44rpx;
  font-weight: 300;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 22rpx rgba(35, 61, 108, 0.18);
}
.mood-close-closing {
  pointer-events: none;
  animation: mood-close-out 160ms ease-out forwards;
}

@keyframes mood-sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes mood-sheet-out {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

@keyframes mood-mask-out {
  from { background: rgba(3, 8, 19, 0.66); }
  to { background: rgba(3, 8, 19, 0); }
}

@keyframes mood-close-out {
  from { opacity: 1; }
  to { opacity: 0; }
}
.mood-tabs {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #eaf0fa;
}
.mood-tab {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 15rpx;
  text-align: center;
  color: #7888a5;
  font-size: 26rpx;
}
.mood-tab-on {
  color: #284c91;
  font-weight: 600;
  background: #ffffff;
  box-shadow: 0 3rpx 11rpx rgba(68, 97, 151, 0.13);
}
.mood-section { margin-top: 28rpx; }
.mood-section-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 13rpx; }
.mood-section-title { color: #263752; font-size: 26rpx; font-weight: 700; }
.mood-section-state, .mood-section-tip { color: #8b9ab4; font-size: 20rpx; }
.mood-style-head { margin-top: 28rpx; }
.mood-options {
  width: 100%;
  white-space: nowrap;
}
.mood-option {
  display: inline-block;
  margin-right: 12rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid #dfe6f2;
  border-radius: 999rpx;
  color: #667895;
  font-size: 23rpx;
  background: #ffffff;
}
.mood-option-on {
  border-color: #789af0;
  color: #305bb3;
  background: #edf3ff;
}
.mood-option-emoji { margin-right: 8rpx; }
.mood-styles {
  width: 100%;
  margin-top: 0;
  white-space: nowrap;
}
.mood-style {
  box-sizing: border-box;
  display: inline-flex;
  flex-direction: column;
  width: 250rpx;
  margin-right: 14rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid #dfe6f2;
  border-radius: 20rpx;
  background: #ffffff;
}
.mood-style-on {
  border-color: #789af0;
  background: linear-gradient(135deg, #edf3ff, #f5f1ff);
}
.mood-style-name {
  color: #38537f;
  font-size: 24rpx;
  font-weight: 600;
}
.mood-style-sub {
  margin-top: 7rpx;
  color: #8695ac;
  font-size: 19rpx;
  line-height: 1.45;
  white-space: normal;
}
.mood-writing { margin-top: 28rpx; padding: 18rpx 20rpx 14rpx; border: 2rpx solid #e1e7f1; border-radius: 22rpx; background: #ffffff; }
.mood-writing-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; color: #3e516f; font-size: 24rpx; font-weight: 600; }
.mood-writing-head text:last-child { color: #9aa7ba; font-size: 20rpx; font-weight: 400; }
.mood-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  margin-top: 8rpx;
  padding: 8rpx 0;
  border: 0;
  border-radius: 0;
  color: #30415d;
  font-size: 26rpx;
  line-height: 1.55;
  background: transparent;
}
.mood-placeholder {
  color: #a4afbf;
}
.mood-preview-wrap {
  margin-top: 20rpx;
  overflow: hidden;
  border: 2rpx solid #e1e7f1;
  border-radius: 24rpx;
  background: #dfeafc;
}
.mood-preview,
.mood-preview-empty {
  display: flex;
  width: 100%;
  height: 360rpx;
}
.mood-preview {
  object-fit: cover;
}
.mood-preview-empty {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #6d7f9c;
  font-size: 22rpx;
  background: radial-gradient(circle at 50% 5%, #ffffff 0%, #eaf2ff 44%, #d8e5fb 100%);
}
.mood-preview-emoji {
  margin-bottom: 12rpx;
  font-size: 64rpx;
}
.mood-preview-title { color: #304c76; font-size: 28rpx; font-weight: 700; }
.mood-preview-sub { margin-top: 8rpx; color: #8293ad; font-size: 20rpx; }
.mood-main-action {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 21rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #4d7ee9, #6b99f6);
  box-shadow: 0 8rpx 22rpx rgba(68, 118, 220, 0.24);
}
.mood-action-icon { font-size: 31rpx; line-height: 1; }
.mood-main-disabled {
  color: rgba(255, 255, 255, 0.62);
  background: #b5c1d3;
  box-shadow: none;
}
.mood-ai-note {
  display: block;
  margin-top: 14rpx;
  color: #788aa6;
  font-size: 21rpx;
  line-height: 1.55;
}
.mood-ready {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 2rpx solid #dce7fb;
  border-radius: 24rpx;
  background: #eef5ff;
}
.mood-ready-title { display: flex; flex-direction: row; align-items: center; justify-content: space-between; color: #38547d; font-size: 25rpx; font-weight: 700; }
.mood-ready-title text:last-child { color: #8092ad; font-size: 19rpx; font-weight: 400; }
.mood-ready-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 14rpx;
}
.mood-secondary {
  flex: 1;
  padding: 16rpx 0;
  border: 2rpx solid #cbdaf1;
  border-radius: 999rpx;
  text-align: center;
  color: #496a99;
  font-size: 24rpx;
  background: #ffffff;
}
.mood-publish-area { margin-top: 28rpx; padding: 22rpx 18rpx 10rpx; border: 2rpx solid #e0e7f2; border-radius: 24rpx; background: #ffffff; }
.mood-publish-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 0 4rpx 16rpx; }
.mood-publish-title, .mood-publish-sub { display: block; }
.mood-publish-title { color: #31445f; font-size: 28rpx; font-weight: 700; }
.mood-publish-sub { margin-top: 5rpx; color: #8a98ac; font-size: 20rpx; }
.mood-publish-head-right { display: flex; flex-direction: row; align-items: center; gap: 10rpx; }
.mood-publish-action {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 18rpx;
  border: 2rpx solid #d7e3f7;
  border-radius: 999rpx;
  color: #315a9d;
  font-size: 22rpx;
  font-weight: 600;
  background: #f3f7ff;
  box-shadow: 0 5rpx 14rpx rgba(57, 91, 153, 0.12);
}
.mood-publish-action-icon { margin-right: 6rpx; font-size: 24rpx; line-height: 1; }
.mood-publish-badge { padding: 5rpx 12rpx; border-radius: 999rpx; color: #4a70b8; font-size: 18rpx; background: #edf3ff; }
.mood-official-unavailable {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 176rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  text-align: center;
  background: #f4f7fc;
}
.mood-official-unavailable-title { display: block; color: #536987; font-size: 24rpx; font-weight: 600; }
.mood-official-unavailable-sub { display: block; margin-top: 10rpx; color: #93a1b6; font-size: 20rpx; line-height: 1.5; }
.mood-privacy {
  display: block;
  margin-top: 14rpx;
  color: #91a0b5;
  font-size: 19rpx;
  line-height: 1.55;
}
.mood-privacy {
  margin: 18rpx 4rpx 0;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.ipt {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 28rpx;
}
.ph {
  color: #7c88a0;
}
.btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  color: #ffffff;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.35);
}
.btn.ghost {
  background: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.chips {
  white-space: nowrap;
  width: 100%;
}
.chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #c3cde0;
  font-size: 26rpx;
}
.chip.on {
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.4);
}
.hint {
  margin-top: 14rpx;
  text-align: center;
  color: #9fb0c8;
  font-size: 26rpx;
}

/* 署名（Open-Meteo CC-BY 4.0 要求界面可见）+ 关于入口 */
.credit {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}
.credit-t {
  font-size: 20rpx;
  color: #6b788c;
}
.credit-a {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #7f9ec4;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
}

/* 加载失败重试 */
.errbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}
.err-t {
  font-size: 26rpx;
  color: #e0908a;
}
.err-btn {
  margin-left: 16rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

/* 3D 不可用时的降级占位 */
.glfail {
  position: absolute;
  left: 0;
  right: 0;
  top: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.glfail-e {
  font-size: 96rpx;
  opacity: 0.5;
}
.glfail-t {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #c3cde0;
}
.glfail-s {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c88a0;
}
