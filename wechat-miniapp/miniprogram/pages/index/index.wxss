.app {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #0b1220;
}

/* 上半屏 3D 画布 */
.gl {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* 昼夜切换按钮：避开微信右上角原生胶囊，固定在画布右侧安全区下方 */
.daynight {
  position: absolute;
  top: calc(168rpx + env(safe-area-inset-top));
  right: 30rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 38rpx;
  border-radius: 999rpx;
  background: rgba(12, 20, 38, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 下半屏控制面板：深色磨砂玻璃卡片（圆角上翻，不与 canvas 重叠） */
.panel {
  flex: none;
  padding: 8rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #18233c 0%, #0e1626 100%);
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.45);
}
.grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 14rpx auto 22rpx;
}

.summary {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 26rpx;
}
.s-left {
  display: flex;
  flex-direction: column;
}
.s-city {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.s-kind {
  font-size: 26rpx;
  color: #9fb0c8;
  margin-top: 8rpx;
}
.s-temp {
  font-size: 96rpx;
  font-weight: 200;
  color: #ffffff;
  line-height: 1;
}

/* 七天预报横条 */
.fc {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 22rpx;
}
.fc-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 104rpx;
  padding: 16rpx 8rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.07);
}
.fc-d {
  font-size: 22rpx;
  color: #9fb0c8;
}
.fc-e {
  font-size: 34rpx;
  margin: 8rpx 0 6rpx;
}
.fc-hi {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}
.fc-lo {
  font-size: 22rpx;
  color: #7c88a0;
  margin-top: 2rpx;
}

/* AI天气助手：默认由 meta.js 关闭，开启后也只在用户主动提问时消耗额度。 */
.ai-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 2rpx 0 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(64, 105, 190, 0.28), rgba(45, 68, 112, 0.42));
  border: 2rpx solid rgba(128, 166, 238, 0.22);
}
.ai-entry-copy {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}
.ai-entry-icon {
  font-size: 38rpx;
  margin-right: 14rpx;
}
.ai-entry-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.ai-entry-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.ai-entry-sub {
  color: #9fb0c8;
  font-size: 21rpx;
  margin-top: 5rpx;
  white-space: nowrap;
}
.ai-entry-btn,
.ai-ask-btn {
  flex: none;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 24rpx;
  background: linear-gradient(135deg, #4f82e1, #6b9cf0);
  box-shadow: 0 5rpx 15rpx rgba(59, 111, 214, 0.28);
}
.ai-panel {
  margin: -4rpx 0 22rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: rgba(8, 17, 34, 0.62);
  border: 2rpx solid rgba(129, 163, 224, 0.18);
}
.ai-panel-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}
.ai-panel-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.ai-panel-note,
.ai-cache,
.ai-disclaimer {
  color: #7f91ad;
  font-size: 20rpx;
}
.ai-prompts {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 16rpx 0 14rpx;
}
.ai-prompt {
  padding: 10rpx 18rpx;
  margin: 0 12rpx 10rpx 0;
  border-radius: 999rpx;
  color: #cbd9f2;
  font-size: 22rpx;
  background: rgba(113, 150, 222, 0.14);
  border: 2rpx solid rgba(128, 166, 238, 0.18);
}
.ai-ask-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}
.ai-input {
  flex: 1;
  min-width: 0;
  height: 70rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
}
.ai-ask-btn {
  height: 70rpx;
  line-height: 70rpx;
  padding-top: 0;
  padding-bottom: 0;
}
.ai-result {
  position: relative;
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
}
.ai-result-text {
  color: #e9f0ff;
  font-size: 24rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  padding-right: 12rpx;
}
.ai-cache {
  margin-top: 10rpx;
}
.ai-copy {
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  color: #cbd9f2;
  font-size: 21rpx;
  background: rgba(255, 255, 255, 0.08);
}
.ai-disclaimer {
  display: block;
  margin-top: 14rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.ipt {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 28rpx;
}
.ph {
  color: #7c88a0;
}
.btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  color: #ffffff;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.35);
}
.btn.ghost {
  background: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.chips {
  white-space: nowrap;
  width: 100%;
}
.chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #c3cde0;
  font-size: 26rpx;
}
.chip.on {
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.4);
}
.hint {
  margin-top: 14rpx;
  text-align: center;
  color: #9fb0c8;
  font-size: 26rpx;
}

/* 署名（Open-Meteo CC-BY 4.0 要求界面可见）+ 关于入口 */
.credit {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
}
.credit-t {
  font-size: 20rpx;
  color: #6b788c;
}
.credit-a {
  margin-left: 14rpx;
  font-size: 20rpx;
  color: #7f9ec4;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
}

/* 加载失败重试 */
.errbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}
.err-t {
  font-size: 26rpx;
  color: #e0908a;
}
.err-btn {
  margin-left: 16rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
}

/* 3D 不可用时的降级占位 */
.glfail {
  position: absolute;
  left: 0;
  right: 0;
  top: 22%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.glfail-e {
  font-size: 96rpx;
  opacity: 0.5;
}
.glfail-t {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #c3cde0;
}
.glfail-s {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c88a0;
}
