.app {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #0b1220;
}

/* 上半屏 3D 画布 */
.gl {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* 下半屏控制面板（不与 canvas 重叠） */
.panel {
  flex: none;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #121a2b;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.3);
}

.summary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.s-left {
  display: flex;
  flex-direction: column;
}
.s-city {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
}
.s-kind {
  font-size: 26rpx;
  color: #aeb8c8;
  margin-top: 4rpx;
}
.s-temp {
  font-size: 72rpx;
  font-weight: 300;
  color: #ffffff;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.ipt {
  flex: 1;
  height: 74rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #1e2942;
  color: #ffffff;
  font-size: 27rpx;
}
.ph {
  color: #7f8aa0;
}
.btn {
  height: 74rpx;
  line-height: 74rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: #2a3a5e;
  color: #ffffff;
  font-size: 27rpx;
}

.chips {
  white-space: nowrap;
  width: 100%;
}
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #1e2942;
  color: #cdd6e6;
  font-size: 26rpx;
}
.chip.on {
  background: #3b6fd6;
  color: #ffffff;
}
.hint {
  margin-top: 12rpx;
  text-align: center;
  color: #aeb8c8;
  font-size: 26rpx;
}
