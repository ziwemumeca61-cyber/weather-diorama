.app {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}
.gl {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
}

/* 顶部天气卡（cover-view：不支持 text-shadow，用半透明深色药丸保证可读） */
.card {
  position: absolute;
  top: 110rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  justify-content: center;
}
.pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx;
  border-radius: 32rpx;
  background-color: rgba(16, 24, 40, 0.42);
}
.city {
  font-size: 56rpx;
  color: #ffffff;
}
.emoji {
  font-size: 60rpx;
  color: #ffffff;
}
.temp {
  font-size: 72rpx;
  color: #ffffff;
}
.kind {
  font-size: 26rpx;
  color: #eaf0f8;
}

/* 底部控制 */
.hud {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 48rpx;
  display: flex;
  flex-direction: column;
}
.row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}
.btn {
  padding: 12rpx 26rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.9);
  color: #2a3a5e;
  font-size: 27rpx;
}
.btn.locate {
  background-color: rgba(42, 58, 94, 0.92);
  color: #ffffff;
}
.btn.on {
  background-color: #2a3a5e;
  color: #ffffff;
}
.chip {
  padding: 12rpx 28rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.88);
  color: #3a4a6a;
  font-size: 26rpx;
}
.chip.on {
  background-color: #2a3a5e;
  color: #ffffff;
}
.loading {
  position: absolute;
  top: 46%;
  left: 0;
  right: 0;
  text-align: center;
  color: #ffffff;
  font-size: 30rpx;
}
