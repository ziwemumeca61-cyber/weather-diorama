.app {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #0b1220;
}

/* 上半屏 3D 画布 */
.gl {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* 昼夜切换按钮：浮在画布右上角的磨砂圆钮 */
.daynight {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 30rpx;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 38rpx;
  border-radius: 999rpx;
  background: rgba(12, 20, 38, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.3);
}

/* 下半屏控制面板：深色磨砂玻璃卡片（圆角上翻，不与 canvas 重叠） */
.panel {
  flex: none;
  padding: 8rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #18233c 0%, #0e1626 100%);
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.45);
}
.grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 14rpx auto 22rpx;
}

.summary {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 26rpx;
}
.s-left {
  display: flex;
  flex-direction: column;
}
.s-city {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
.s-kind {
  font-size: 26rpx;
  color: #9fb0c8;
  margin-top: 8rpx;
}
.s-temp {
  font-size: 96rpx;
  font-weight: 200;
  color: #ffffff;
  line-height: 1;
}

/* 七天预报横条 */
.fc {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 22rpx;
}
.fc-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 104rpx;
  padding: 16rpx 8rpx;
  margin-right: 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 2rpx solid rgba(255, 255, 255, 0.07);
}
.fc-d {
  font-size: 22rpx;
  color: #9fb0c8;
}
.fc-e {
  font-size: 34rpx;
  margin: 8rpx 0 6rpx;
}
.fc-hi {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}
.fc-lo {
  font-size: 22rpx;
  color: #7c88a0;
  margin-top: 2rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.ipt {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 28rpx;
}
.ph {
  color: #7c88a0;
}
.btn {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  color: #ffffff;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.35);
}
.btn.ghost {
  background: rgba(255, 255, 255, 0.08);
  box-shadow: none;
}

.chips {
  white-space: nowrap;
  width: 100%;
}
.chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  color: #c3cde0;
  font-size: 26rpx;
}
.chip.on {
  background: linear-gradient(135deg, #3b6fd6, #5a86e6);
  border-color: transparent;
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(59, 111, 214, 0.4);
}
.hint {
  margin-top: 14rpx;
  text-align: center;
  color: #9fb0c8;
  font-size: 26rpx;
}
